{
  "name": "vigilagent",
  "displayName": "VigilAgent — AI Code Verification",
  "description": "Verify AI-generated code with VigilAgent's dual-engine analysis. Parallel deterministic + LLM scanning with corroboration scoring.",
  "version": "0.0.1",
  "publisher": "vigilagent",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Other"
  ],
  "keywords": [
    "ai",
    "code-review",
    "security",
    "verification",
    "llm",
    "mcp"
  ],
  "activationEvents": [
    "onChatParticipant:vigilagent",
    "onView:vigilagentFindings",
    "onCommand:vigilagent.refreshFindings",
    "onCommand:vigilagent.clearFindings"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languageModelChatProviders": [
      {
        "vendor": "vigilagent",
        "name": "VigilAgent"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "vigilagentFindings",
          "name": "Security Findings"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "vigilagentFindings",
        "contents": "No scans yet.\n[Run Dual-Engine Analysis](command:vigilagent.dualEngine)\nScans from the gateway and all VigilAgent commands appear here, grouped by severity with provenance labels."
      }
    ],
    "chatParticipants": [
      {
        "id": "vigilagent",
        "fullName": "VigilAgent",
        "name": "vigilagent",
        "description": "Verify code with VigilAgent's deterministic engine and parallel LLM reviewers",
        "modelId": "*"
      }
    ],
    "commands": [
      {
        "command": "vigilagent.configure",
        "title": "VigilAgent: Configure API Keys"
      },
      {
        "command": "vigilagent.scanFile",
        "title": "VigilAgent: Scan Current File"
      },
      {
        "command": "vigilagent.scanChangedFiles",
        "title": "VigilAgent: Scan Changed Files"
      },
      {
        "command": "vigilagent.scanDesignDocument",
        "title": "VigilAgent: Scan Design Document"
      },
      {
        "command": "vigilagent.verifySelection",
        "title": "VigilAgent: Verify Selected Code"
      },
      {
        "command": "vigilagent.dualEngine",
        "title": "VigilAgent: Dual-Engine Analysis"
      },
      {
        "command": "vigilagent.dismissSuggestion",
        "title": "VigilAgent: Dismiss Suggestion"
      },
      {
        "command": "vigilagent.refreshFindings",
        "title": "VigilAgent: Refresh Security Findings"
      },
      {
        "command": "vigilagent.clearFindings",
        "title": "VigilAgent: Clear Security Findings"
      }
    ],
    "configuration": {
      "title": "VigilAgent",
      "properties": {
        "vigilagent.backendUrl": {
          "type": "string",
          "default": "http://localhost:8080",
          "description": "VigilAgent backend URL"
        },
        "vigilagent.gatewayUrl": {
          "type": "string",
          "default": "http://localhost:9090",
          "description": "VigilAgent Secure AI Gateway URL — chat models and the /v1/responses scan-and-release pipeline"
        },
        "vigilagent.mcpBinaryPath": {
          "type": "string",
          "default": "",
          "description": "Optional absolute path to the vigilagent-mcp binary. When empty, the extension uses the bundled binary in vendor/ (or the repo mcp-server/vendor/ layout in development)."
        },
        "vigilagent.defaultLanguage": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "go",
            "python",
            "javascript",
            "typescript",
            "rust",
            "java"
          ],
          "description": "Default programming language for scans"
        },
        "vigilagent.autoVerify": {
          "type": "boolean",
          "default": true,
          "description": "Automatically run VigilAgent verification on LLM responses"
        },
        "vigilagent.showConfidenceBadge": {
          "type": "boolean",
          "default": true,
          "description": "Show confidence score in the status bar"
        },
        "vigilagent.llmProvider": {
          "type": "string",
          "default": "NVIDIA NIM",
          "enum": [
            "NVIDIA NIM",
            "OpenAI",
            "Anthropic",
            "Google Gemini",
            "Mistral",
            "Groq",
            "Cohere"
          ],
          "description": "LLM provider for the review pipeline"
        },
        "vigilagent.llmModel": {
          "type": "string",
          "default": "kimi-k2.6",
          "description": "Model name to use with the selected LLM provider"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "typecheck": "tsc --noEmit -p ./",
    "test": "vitest run",
    "package": "vsce package",
    "publish:openvsx": "ovsx publish",
    "publish:marketplace": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.100.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.0.0",
    "eslint": "^8.57.0",
    "ovsx": "^1.1.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.10"
  }
}
